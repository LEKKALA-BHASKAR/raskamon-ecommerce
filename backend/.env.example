# ── Database ────────────────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=...
DB_NAME=sattva_store

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cloudinary (image uploads) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.razorpay.com
# Test keys: rzp_test_... / live keys: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret   # set when registering webhook in dashboard

# ── PhonePe ──────────────────────────────────────────────────────────────────
# Dashboard: https://business.phonepe.com
# Sandbox merchant ID for testing: PGTESTPAYUAT
# Sandbox salt key: 099eb0cd-02cf-4e2a-8aca-3e6c6aff0399  salt index: 1
PHONEPE_MERCHANT_ID=PGTESTPAYUAT
PHONEPE_SALT_KEY=099eb0cd-02cf-4e2a-8aca-3e6c6aff0399
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox   # sandbox | production

# ── Airpay ───────────────────────────────────────────────────────────────────
# Sign up: https://airpay.co.in
# UAT credentials provided by Airpay after merchant registration
AIRPAY_MERCHANT_ID=your_merchant_id
AIRPAY_SECRET_KEY=your_secret_key
AIRPAY_USERNAME=your_username
AIRPAY_PASSWORD=your_password
AIRPAY_ENV=sandbox   # sandbox | production

# ── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000   # public-facing URL for webhook callbacks

# ── Store ────────────────────────────────────────────────────────────────────
STORE_NAME=Sattva

# ── Email (optional) ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
