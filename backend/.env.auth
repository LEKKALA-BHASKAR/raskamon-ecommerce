# ╔════════════════════════════════════════════════════════════════════╗
# ║  ADD THESE TO YOUR backend/.env FILE                              ║
# ║  Replace placeholder values with your real keys                   ║
# ╚════════════════════════════════════════════════════════════════════╝

# ── Google OAuth ───────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
# Create an OAuth 2.0 Client ID (Web application type)
# Add http://localhost:3000 to Authorized JavaScript origins
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── CAPTCHA (reCAPTCHA v3 / hCaptcha / Turnstile) ─────────────────────
# reCAPTCHA v3: https://www.google.com/recaptcha/admin
# hCaptcha:     https://dashboard.hcaptcha.com
# Turnstile:    https://dash.cloudflare.com (Turnstile section)
CAPTCHA_PROVIDER=recaptcha
CAPTCHA_SECRET_KEY=your_recaptcha_secret_key
CAPTCHA_SCORE_THRESHOLD=0.5

# ── Dev Mode ───────────────────────────────────────────────────────────
# Set to 1 to return OTP values in API responses (for testing)
# REMOVE or set to 0 in production!
DEV_MODE=1

# ── SMS Gateway (for Mobile OTP) ──────────────────────────────────────
# Integrate MSG91 / Twilio / AWS SNS — currently OTP is logged to console
# Uncomment and configure when ready:
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=your_msg91_auth_key
# MSG91_SENDER_ID=DRMEDI
# MSG91_TEMPLATE_ID=your_template_id
# --- OR for Twilio ---
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890
